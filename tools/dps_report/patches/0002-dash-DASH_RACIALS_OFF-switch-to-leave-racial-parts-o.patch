 func (priest *Priest) registerDarkSacrificeSpell() {
-	if priest.Race != proto.Race_RaceUndead {
+	if priest.Race != proto.Race_RaceUndead || core.DashRacialOff("darksacrifice") {
 		return
 	}
 
diff --git a/sim/priest/starshards.go b/sim/priest/starshards.go
index 12f6d11d0..9394e8617 100644
--- a/sim/priest/starshards.go
