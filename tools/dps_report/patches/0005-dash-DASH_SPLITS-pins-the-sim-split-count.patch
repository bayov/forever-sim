--- a/sim/core/sim_concurrent.go
+++ b/sim/core/sim_concurrent.go
@@ -4,9 +4,11 @@ import (
 	"fmt"
 	"log"
 	"math"
+	"os"
 	"reflect"
 	"runtime"
 	"runtime/debug"
+	"strconv"
 
 	"github.com/wowsims/classic/sim/core/proto"
 	"github.com/wowsims/classic/sim/core/simsignals"
@@ -516,7 +518,7 @@ func runSimConcurrent(request *proto.RaidSimRequest, progress chan *proto.Progre
 		}
 	}()
 
-	splitRes := SplitSimRequestForConcurrency(request, TernaryInt32(request.SimOptions.IsTest, 3, int32(runtime.NumCPU())))
+	splitRes := SplitSimRequestForConcurrency(request, TernaryInt32(request.SimOptions.IsTest, 3, dashSplits()))
 
 	if splitRes.ErrorResult != "" {
 		panic(splitRes.ErrorResult)
@@ -640,3 +642,12 @@ func combineLevelingMetrics(base, add *proto.LevelingMetrics, isLast bool, weigh
 		base.MobsKilledStdev = math.Sqrt(max(base.MobsKilledStdev-base.MobsKilled*base.MobsKilled, 0))
 	}
 }
+
+// dashSplits is the number of concurrent splits a sim runs in: DASH_SPLITS when set (the DPS report
+// pins it, so its raw outputs don't depend on the machine's core count), else one per CPU.
+func dashSplits() int32 {
+	if n, err := strconv.Atoi(os.Getenv("DASH_SPLITS")); err == nil && n > 0 {
+		return int32(n)
+	}
+	return int32(runtime.NumCPU())
+}
