dash: DASH_ASSUME knobs for the dashboard's assumption scenarios (local only)

Dashboard-only knobs read by run_assumptions.py: DASH_ASSUME="key=value,..." overrides the constants the
assumption scenarios vary (sim/core/assumptions.go). With the variable unset the sim is bit-identical.
Each knob on a constant master sets (the rank scales, Ice Lance's coefficient, Rend's attack power share,
the hunter's crit per Agility, Raptor Strike rank 8, the pet hit rule, the top Trueshot Aura and Hunter's
Mark ranks, the damage taken Rage factor, Seal of Command's rate, the bleed tick crit, the Fire trap's
attack power) defaults to that constant, so a run with no knob reproduces master. Rebased 2026-10-23 onto
claude/keen-brown-o2g32n (the wowsims/forever alignment round) with patches 0001 to 0003 applied: the knobs
of the assumptions that round settled (warr_dt_rage_mods, druid_ooc_rate, hunter_pet_scaling's
hunter_pet_ap / hunter_pet_hit, lock_pet_scaling, lock_demon_melee, pal_2h_spec_holy) are dropped,
druid_rip_scale and pal_cons31 follow the new Rip and Consecration code, hunter_cobra_damage is new, and
pal_soc_wf's Windfury Totem check is back in CreateExtraAttackAuraCommon (it had been lost, so the knob
did nothing). 2026-10-25: mage_am_mb is new (0: Arcane Missiles' missiles don't proc Missile Barrage), and
hunter_pet_same_hit is dropped (wowsims/forever's level 17 pet sheet settled it).

diff --git a/sim/core/assumptions.go b/sim/core/assumptions.go
new file mode 100644
index 0000000000..8edf2869b6
--- /dev/null
+++ b/sim/core/assumptions.go
@@ -0,0 +1,64 @@
+package core
+
+import (
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+
+	"github.com/wowsims/classic/sim/core/stats"
+)
+
+// Dashboard-only assumption knobs (local dashdata tree, never pushed).
+//
+// DASH_ASSUME="key=value,key=value" overrides the constants the dashboard's assumption
+// scenarios vary. With the variable unset every call returns its default, and the code paths
+// that read a knob through AssumeOk are skipped entirely, so the sim is bit-identical to the
+// class branches.
+
+var (
+	assumeOnce sync.Once
+	assumeVals map[string]float64
+)
+
+func loadAssume() {
+	assumeVals = map[string]float64{}
+	for _, kv := range strings.Split(os.Getenv("DASH_ASSUME"), ",") {
+		k, v, ok := strings.Cut(kv, "=")
+		if !ok {
+			continue
+		}
+		if f, err := strconv.ParseFloat(strings.TrimSpace(v), 64); err == nil {
+			assumeVals[strings.TrimSpace(k)] = f
+		}
+	}
+}
+
+// AssumeOk returns the DASH_ASSUME override for key, and whether there is one.
+func AssumeOk(key string) (float64, bool) {
+	assumeOnce.Do(loadAssume)
+	v, ok := assumeVals[key]
+	return v, ok
+}
+
+// Assume returns the DASH_ASSUME override for key, or def when there is none.
+func Assume(key string, def float64) float64 {
+	if v, ok := AssumeOk(key); ok {
+		return v
+	}
+	return def
+}
+
+// AssumeNoWindfury maps spell IDs to the knob that, when set to 0, keeps them from procing
+// Windfury Totem. Classes fill it from package init only, so it is never written during a sim.
+var AssumeNoWindfury = map[int32]string{}
+
+// tickCritMultiplier is a periodic tick's crit multiplier. DASH_ASSUME bleed_tick_crit scales a
+// physical tick crit's bonus: 0.5 makes a 200% bleed crit deal 150%.
+func (dot *Dot) tickCritMultiplier(attackTable *AttackTable) float64 {
+	critMultiplier := dot.Spell.CritMultiplier(attackTable)
+	if v, ok := AssumeOk("bleed_tick_crit"); ok && dot.Spell.SchoolIndex == stats.SchoolIndexPhysical {
+		critMultiplier = 1 + (critMultiplier-1)*v
+	}
+	return critMultiplier
+}
