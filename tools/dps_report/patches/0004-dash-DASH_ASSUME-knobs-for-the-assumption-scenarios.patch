@@ -0,0 +1,116 @@
+package dpswarrior
+
+import (
+	"math"
+	"testing"
+	"time"
+
+	"github.com/wowsims/classic/sim/core"
+	"github.com/wowsims/classic/sim/core/proto"
+	"github.com/wowsims/classic/sim/core/simsignals"
+	"github.com/wowsims/classic/sim/core/stats"
+)
+
+// assumeWarrior is a level 60 Orc Fury warrior under Forever with Windfury Totem, built after
+// DASH_ASSUME is set to env (the dashboard's assumption knobs, sim/core/assumptions.go).
+func assumeWarrior(t *testing.T, env string) (*core.Simulation, *DpsWarrior) {
+	t.Helper()
+	core.AssumeForTest(env)
+	t.Cleanup(func() { core.AssumeForTest("") })
+	items := make([]*proto.ItemSpec, 17)
+	for i := range items {
+		items[i] = &proto.ItemSpec{}
+	}
+	items[proto.ItemSlot_ItemSlotMainHand] = &proto.ItemSpec{Id: 991014}
+	items[proto.ItemSlot_ItemSlotOffHand] = &proto.ItemSpec{Id: 991015}
+	player := &proto.Player{
+		Race:          proto.Race_RaceOrc,
+		Class:         proto.Class_ClassWarrior,
+		Level:         60,
+		Equipment:     &proto.EquipmentSpec{Items: items},
+		TalentsString: P1Talents,
+		Rotation:      &proto.APLRotation{},
+		Spec:          &proto.Player_Warrior{Warrior: &proto.Warrior{Options: &proto.Warrior_Options{}}},
+	}
+	sim := core.NewSim(&proto.RaidSimRequest{
+		Raid: core.SinglePlayerRaidProto(player, &proto.PartyBuffs{},
+			&proto.RaidBuffs{TotemWeaponBuff: proto.TotemWeaponBuff_TotemWeaponBuffWindfury}, &proto.Debuffs{}),
+		Encounter:  &proto.Encounter{Duration: 600, Targets: []*proto.Target{core.NewDefaultTarget()}},
+		SimOptions: &proto.SimOptions{Ruleset: proto.Ruleset_RulesetForever, RandomSeed: 1},
+	}, simsignals.CreateSignals())
+	sim.Reset()
+	return sim, sim.Raid.Parties[0].Players[0].(*DpsWarrior)
+}
+
+// TestAssumeExecuteWindfuryTwice: with warr_exec_wf2=1 an Execute's own attack rolls Windfury
+// Totem before its damage, so a landed Execute can roll it twice (about 36% a cast, less the
+// misses and dodges); with the knob off it rolls once (about 20% of the casts that land).
+func TestAssumeExecuteWindfuryTwice(t *testing.T) {
+	const n = 4000
+	rate := func(env string) float64 {
+		sim, dw := assumeWarrior(t, env)
+		war := dw.GetWarrior()
+		buff := war.GetAura("Windfury Attack")
+		if buff == nil || war.Execute == nil {
+			t.Fatal("no Windfury Totem or Execute on the warrior")
+		}
+		procs := 0
+		for range n {
+			sim.CurrentTime += 2 * time.Second
+			buff.Deactivate(sim)
+			war.Execute.ApplyEffects(sim, war.CurrentTarget, war.Execute.Spell)
+			if buff.IsActive() {
+				procs++
+			}
+		}
+		return float64(procs) / n
+	}
+	once, twice := rate(""), rate("warr_exec_wf2=1")
+	t.Logf("Windfury Totem procs a cast: %.3f with one roll, %.3f with two", once, twice)
+	if once < 0.13 || once > 0.21 {
+		t.Errorf("Execute procced Windfury Totem on %.3f of casts with one roll, want just under 0.2 (the casts that land)", once)
+	}
+	if twice < 0.27 || twice > 0.37 {
+		t.Errorf("Execute procced Windfury Totem on %.3f of casts with two rolls, want about 0.33", twice)
+	}
+	if off := rate("warr_exec_wf2=0"); math.Abs(off-once) > 1e-9 {
+		t.Errorf("warr_exec_wf2=0 gives %.3f, want the default's %.3f", off, once)
+	}
+}
+
+// TestAssumeBloodFuryAPOnly: with orc_bf_weapon=0 Blood Fury gives its 10% attack power and no
+// weapon damage; by default it adds 10% of each weapon's average damage too.
+func TestAssumeBloodFuryAPOnly(t *testing.T) {
+	for _, c := range []struct {
+		env    string
+		weapon bool
+	}{{"", true}, {"orc_bf_weapon=0", false}} {
+		sim, dw := assumeWarrior(t, c.env)
+		war := dw.GetWarrior()
+		bf := war.GetAura("Blood Fury")
+		if bf == nil {
+			t.Fatal("no Blood Fury on the Orc")
+		}
+		mh, oh := war.AutoAttacks.MH(), war.AutoAttacks.OH()
+		ap, mhMin, ohMax, mhAvg := war.GetStat(stats.AttackPower), mh.BaseDamageMin, oh.BaseDamageMax, mh.AverageDamage()
+		bf.Activate(sim)
+		if got := war.GetStat(stats.AttackPower); math.Abs(got-1.1*ap) > 0.01 {
+			t.Errorf("%q: attack power %.2f under Blood Fury, want %.2f", c.env, got, 1.1*ap)
+		}
+		wantMin := mhMin
+		if c.weapon {
+			wantMin += 0.1 * mhAvg
+		}
+		if math.Abs(mh.BaseDamageMin-wantMin) > 1e-9 {
+			t.Errorf("%q: main hand minimum %.2f under Blood Fury, want %.2f", c.env, mh.BaseDamageMin, wantMin)
+		}
+		if !c.weapon && oh.BaseDamageMax != ohMax {
+			t.Errorf("%q: off-hand maximum %.2f under Blood Fury, want %.2f", c.env, oh.BaseDamageMax, ohMax)
+		}
+		bf.Deactivate(sim)
+		if mh.BaseDamageMin != mhMin || war.GetStat(stats.AttackPower) != ap {
+			t.Errorf("%q: Blood Fury's expiry left the main hand at %.2f and attack power at %.2f, want %.2f and %.2f",
+				c.env, mh.BaseDamageMin, war.GetStat(stats.AttackPower), mhMin, ap)
+		}
+	}
+}
