dash: DASH_ASSUME knobs for the dashboard's assumption scenarios (local only)

Dashboard-only knobs read by run_assumptions.py: DASH_ASSUME="key=value,..." overrides the constants the
assumption scenarios vary (sim/core/assumptions.go). With the variable unset the sim is bit-identical.
Each knob on a constant master sets (the rank scales, Ice Lance's coefficient, Rend's attack power share,
the hunter's crit per Agility, Raptor Strike rank 8, the pet hit rule, the top Trueshot Aura and Hunter's
Mark ranks, the damage taken Rage factor, Seal of Command's rate, the bleed tick crit, the Fire trap's
attack power) defaults to that constant, so a run with no knob reproduces master. Rebased 2026-10-23 onto
claude/keen-brown-o2g32n (the wowsims/forever alignment round) with patches 0001 to 0003 applied: the knobs
of the assumptions that round settled (warr_dt_rage_mods, druid_ooc_rate, hunter_pet_scaling's
hunter_pet_ap / hunter_pet_hit, lock_pet_scaling, lock_demon_melee, pal_2h_spec_holy) are dropped,
druid_rip_scale and pal_cons31 follow the new Rip and Consecration code, hunter_cobra_damage is new, and
pal_soc_wf's Windfury Totem check is back in CreateExtraAttackAuraCommon (it had been lost, so the knob
did nothing). 2026-10-25: mage_am_mb is new (0: Arcane Missiles' missiles don't proc Missile Barrage), and
hunter_pet_same_hit is dropped (wowsims/forever's level 17 pet sheet settled it). 2026-10-27: mage_am_mb is
dropped again (user ruling: the missiles don't proc it, now master's Forever rule). hunter_hm60 also sets the
hunter's own Hunter's Mark (ForeverHuntersMarkAura): since the 2026-10-25 ruling every hunter preset casts
its own with the raid's off, so the knob on the raid debuff alone no longer reached them.
2026-10-25 (user rulings): hunter_crit_per_agi now replaces the hunter's level's scale over Classic
(ForeverCritPerAgiScale(level), Forever's PlayerExpectedStat table, 1 at 60), the rows collapsed to one
value keep their knobs (warr_rage_s at master's flat 0, hunter_crit_per_agi, hunter_raptor8, the rank
scales, priest_sf_tick_crit, lock_bod_coef, pal_hs_flat31 / pal_cons31, warr_rend_ap, hunter_cobra_damage,
bleed_tick_crit, warr_dt_rage_k) so a setting can come back without a rebase, and hunter_hm60 is set by
no setting now that Hunter's Mark is settled at 143.
2026-10-26: haste_gcd is new (1: cast speed shortens a spell's GCD, down to 1s, as in wowsims/forever's
hastedGCD; physical abilities keep theirs, as there).
2026-11-03: druid_rip_scale is dropped (the November 2 development notes raise Rip by 25%, standards 37).
2026-11-03: sham_lb_31plus and sham_es7_tuning are dropped (the notes retune Lightning Bolt and Earth Shock;
the sim's scales are 1.0 and the report rows are gone).
2026-11-12: rebased onto the Windfury Totem change (CreateExtraAttackAuraCommon takes rollsOn); context only.

2026-11-15 (user rulings, both probable game bugs): warr_exec_wf2 is new (1: Execute's cast makes an attack of
its own before the damage, which rolls Windfury Totem when it lands, as wowsims/forever's logs show; the
sim rolls once by default; Character.AssumeWindfuryPreAttack, the totem's roll kept on the character), and
orc_bf_weapon is new (0: Blood Fury gives its attack and spell power without the 10% weapon damage).
sim/warrior/dps_warrior/assume_test.go tests both; core.AssumeForTest reloads the knobs.

diff --git a/sim/core/assumptions.go b/sim/core/assumptions.go
new file mode 100644
index 000000000..dc4feda4b
--- /dev/null
+++ b/sim/core/assumptions.go
@@ -0,0 +1,102 @@
+package core
+
+import (
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+
+	"github.com/wowsims/classic/sim/core/stats"
+)
+
+// Dashboard-only assumption knobs (local dashdata tree, never pushed).
+//
+// DASH_ASSUME="key=value,key=value" overrides the constants the dashboard's assumption
+// scenarios vary. With the variable unset every call returns its default, and the code paths
+// that read a knob through AssumeOk are skipped entirely, so the sim is bit-identical to the
+// class branches.
+
+var (
+	assumeOnce sync.Once
+	assumeVals map[string]float64
+)
+
+func loadAssume() {
+	assumeVals = map[string]float64{}
+	for _, kv := range strings.Split(os.Getenv("DASH_ASSUME"), ",") {
+		k, v, ok := strings.Cut(kv, "=")
+		if !ok {
+			continue
+		}
+		if f, err := strconv.ParseFloat(strings.TrimSpace(v), 64); err == nil {
+			assumeVals[strings.TrimSpace(k)] = f
+		}
+	}
+}
+
+// AssumeOk returns the DASH_ASSUME override for key, and whether there is one.
+func AssumeOk(key string) (float64, bool) {
+	assumeOnce.Do(loadAssume)
+	v, ok := assumeVals[key]
+	return v, ok
+}
+
+// Assume returns the DASH_ASSUME override for key, or def when there is none.
+func Assume(key string, def float64) float64 {
+	if v, ok := AssumeOk(key); ok {
+		return v
+	}
+	return def
+}
+
+// AssumeNoWindfury maps spell IDs to the knob that, when set to 0, keeps them from procing
+// Windfury Totem. Classes fill it from package init only, so it is never written during a sim.
+var AssumeNoWindfury = map[int32]string{}
+
+// tickCritMultiplier is a periodic tick's crit multiplier. DASH_ASSUME bleed_tick_crit scales a
+// physical tick crit's bonus: 0.5 makes a 200% bleed crit deal 150%.
+func (dot *Dot) tickCritMultiplier(attackTable *AttackTable) float64 {
+	critMultiplier := dot.Spell.CritMultiplier(attackTable)
+	if v, ok := AssumeOk("bleed_tick_crit"); ok && dot.Spell.SchoolIndex == stats.SchoolIndexPhysical {
+		critMultiplier = 1 + (critMultiplier-1)*v
+	}
+	return critMultiplier
+}
+
+// AssumeForTest reloads the knobs from env, as if DASH_ASSUME were set to it. Tests only.
+func AssumeForTest(env string) {
+	assumeOnce = sync.Once{}
+	os.Setenv("DASH_ASSUME", env)
+	assumeOnce.Do(loadAssume)
+}
+
+// AssumeWindfuryPreAttack is the dashboard assumption warr_exec_wf2 = 1: the cast makes an
+// attack of its own before its damage, and that attack rolls Windfury Totem when it lands, so a
+// landed cast rolls it twice. wowsims/forever's logs show it for Execute (0e8c4a769: 31.6% of
+// landed Executes and 18.9% of dodged ones rolled the totem); the user takes it for a game bug,
+// so the sim rolls once by default. The attack deals nothing, procs nothing else and counts no
+// hit; it rolls its own miss, dodge and parry on a stream of its own.
+func (character *Character) AssumeWindfuryPreAttack(sim *Simulation, spell *Spell, target *Unit, key string) {
+	if v, ok := AssumeOk(key); !ok || v == 0 || character.dashWindfuryRoll == nil {
+		return
+	}
+	attackTable := spell.Unit.AttackTables[target.UnitIndex][spell.CastType]
+	result := &SpellResult{Target: target, Outcome: OutcomeEmpty}
+	roll := sim.RandomFloat("Windfury Pre-Attack")
+	chance := 0.0
+	if !result.applyAttackTableMissNoDWPenalty(spell, attackTable, roll, &chance, false) &&
+		!result.applyAttackTableDodge(spell, attackTable, roll, &chance, false) &&
+		!(spell.Unit.PseudoStats.InFrontOfTarget && result.applyAttackTableParry(spell, attackTable, roll, &chance, false)) {
+		result.applyAttackTableHit(spell, false)
+	}
+	if result.Landed() {
+		character.dashWindfuryRoll(sim, spell)
+	}
+}
+
+// AssumeBloodFuryWeapon is the dashboard assumption orc_bf_weapon: 0 leaves out Blood Fury's 10%
+// weapon damage, keeping the attack and spell power the tooltip gives. The logs show the weapon
+// part; the user takes it for a game bug.
+func AssumeBloodFuryWeapon() bool {
+	return Assume("orc_bf_weapon", 1) != 0
+}
