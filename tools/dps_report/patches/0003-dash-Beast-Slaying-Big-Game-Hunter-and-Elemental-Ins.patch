 sim/core/racials.go | 1 -
 1 file changed, 1 deletion(-)

diff --git a/sim/core/racials.go b/sim/core/racials.go
index 16c04b65d..f309474ec 100644
--- a/sim/core/racials.go
+++ b/sim/core/racials.go
@@ -133,7 +133,6 @@ func applyRaceEffects(agent Agent) {
 				if t.MobType == proto.MobType_MobTypeBeast {
 					for _, at := range character.AttackTables[t.UnitIndex] {
 						at.DamageDealtMultiplier *= 1.05
-						at.CritMultiplier *= 1.05
 					}
 				}
 			}
