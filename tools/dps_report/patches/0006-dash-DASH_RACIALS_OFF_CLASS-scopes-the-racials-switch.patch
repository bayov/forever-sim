From 7d395026e7610d5c228d1c5303b53d2f455e236b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 18:05:12 +0000
Subject: [PATCH] dash: DASH_RACIALS_OFF_CLASS scopes the racials switch to one
 class

The healing bench's raid has a tank and damage dealers of other classes, who keep their
racials while the healer's are left out.
---
 sim/core/racials_forever.go  | 16 +++++++++++++++-
 sim/priest/chastise.go       |  2 +-
 sim/priest/dark_sacrifice.go |  2 +-
 sim/priest/shadowguard.go    |  2 +-
 sim/priest/starshards.go     |  2 +-
 5 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/sim/core/racials_forever.go b/sim/core/racials_forever.go
index 08118d4..cfb882f 100644
--- a/sim/core/racials_forever.go
+++ b/sim/core/racials_forever.go
@@ -42,6 +42,20 @@ var dashRacialsOff = func() map[string]bool {
 	return off
 }()
 
+// DASH_RACIALS_OFF_CLASS (dashboard builds only) names the one class DASH_RACIALS_OFF applies to, so a
+// raid of other classes (the healing bench's tank and damage dealers) keeps its racials. Unset, it
+// applies to every class.
+var dashRacialsOffClass = strings.ToLower(strings.TrimSpace(os.Getenv("DASH_RACIALS_OFF_CLASS")))
+
+// DashRacialOffFor reports whether DASH_RACIALS_OFF leaves the named racial part out for a
+// character of this class.
+func DashRacialOffFor(class proto.Class, name string) bool {
+	if dashRacialsOffClass != "" && strings.ToLower(strings.TrimPrefix(class.String(), "Class")) != dashRacialsOffClass {
+		return false
+	}
+	return DashRacialOff(name)
+}
+
 // DashRacialOff reports whether DASH_RACIALS_OFF leaves the named racial part out.
 func DashRacialOff(name string) bool {
 	return dashRacialsOff["all"] || dashRacialsOff[name]
@@ -49,7 +63,7 @@ func DashRacialOff(name string) bool {
 
 func applyForeverRaceEffects(agent Agent) {
 	character := agent.GetCharacter()
-	on := func(name string) bool { return !DashRacialOff(name) }
+	on := func(name string) bool { return !DashRacialOffFor(character.Class, name) }
 
 	switch character.Race {
 	case proto.Race_RaceHuman:
diff --git a/sim/priest/chastise.go b/sim/priest/chastise.go
index 4a30ddd..83411fb 100644
--- a/sim/priest/chastise.go
+++ b/sim/priest/chastise.go
@@ -19,7 +19,7 @@ var ChastiseManaCost = [ChastiseRanks + 1]float64{0, 50, 100, 135, 180, 225}
 var ChastiseLevel = [ChastiseRanks + 1]int{0, 20, 30, 40, 50, 60}
 
 func (priest *Priest) registerChastiseSpell() {
-	if priest.Race != proto.Race_RaceDwarf || core.DashRacialOff("chastise") {
+	if priest.Race != proto.Race_RaceDwarf || core.DashRacialOffFor(priest.Class, "chastise") {
 		return
 	}
 
diff --git a/sim/priest/dark_sacrifice.go b/sim/priest/dark_sacrifice.go
index c80862c..c4f7c3f 100644
--- a/sim/priest/dark_sacrifice.go
+++ b/sim/priest/dark_sacrifice.go
@@ -21,7 +21,7 @@ var DarkSacrificeTickMana = [DarkSacrificeRanks + 1]float64{0, 88, 144, 204, 266
 var DarkSacrificeLevel = [DarkSacrificeRanks + 1]int{0, 20, 30, 40, 50, 60}
 
 func (priest *Priest) registerDarkSacrificeSpell() {
-	if priest.Race != proto.Race_RaceUndead || core.DashRacialOff("darksacrifice") {
+	if priest.Race != proto.Race_RaceUndead || core.DashRacialOffFor(priest.Class, "darksacrifice") {
 		return
 	}
 
diff --git a/sim/priest/shadowguard.go b/sim/priest/shadowguard.go
index 591e83b..3367b2c 100644
--- a/sim/priest/shadowguard.go
+++ b/sim/priest/shadowguard.go
@@ -28,7 +28,7 @@ var ShadowguardLevel = [ShadowguardRanks + 1]int{0, 20, 28, 36, 44, 52, 60}
 const ShadowguardStrikeCoef = 0.267
 
 func (priest *Priest) registerShadowguardSpell() {
-	if priest.Race != proto.Race_RaceTroll || !priest.Env.IsForever() || core.DashRacialOff("shadowguard") {
+	if priest.Race != proto.Race_RaceTroll || !priest.Env.IsForever() || core.DashRacialOffFor(priest.Class, "shadowguard") {
 		return
 	}
 
diff --git a/sim/priest/starshards.go b/sim/priest/starshards.go
index 9394e86..c98879f 100644
--- a/sim/priest/starshards.go
+++ b/sim/priest/starshards.go
@@ -23,7 +23,7 @@ var StarshardsLevel = [StarshardsRanks + 1]int{0, 10, 18, 26, 34, 42, 50, 58}
 const StarshardsTickCoef = 0.167
 
 func (priest *Priest) registerStarshardsSpell() {
-	if priest.Race != proto.Race_RaceNightElf || core.DashRacialOff("starshards") {
+	if priest.Race != proto.Race_RaceNightElf || core.DashRacialOffFor(priest.Class, "starshards") {
 		return
 	}
 
